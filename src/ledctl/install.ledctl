# ledctl goes in FLASH, not on the payload: the boot sequence drives the LEDs
# before extra is mounted, and rescue has no other way to talk to the user.
# That is why this installs to home/yi-hack/base/bin and not to extra/bin.

SCRIPT_DIR=$(cd `dirname $0` && pwd)
cd $SCRIPT_DIR

mkdir -p ../../build/home/yi-hack/base/bin/ || exit 1

cp -a ./_install/bin/ledctl ../../build/home/yi-hack/base/bin/ || exit 1
