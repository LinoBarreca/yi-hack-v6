--- onvif_simple_server.ori/media_service.c
+++ onvif_simple_server/media_service.c
@@ -26,6 +26,25 @@
 
 extern service_context_t service_ctx;
 
+// Substitute the camera address into a stream/snapshot URL template from the
+// config. The template holds a single literal "%s" placeholder for the address.
+// It must NOT be used as a printf format string: the URL embeds the RTSP
+// user:password, which is user-controlled and may legitimately contain '%' (the
+// password is percent-encoded, or contains a literal '%'). Passing it to sprintf
+// makes those '%' sequences act as format directives - corrupting the URL (the
+// symptom: an ONVIF client receiving a mangled URI with the %s unsubstituted) and,
+// because it is a classic format-string bug, risking a crash on a hostile password.
+// Do a plain literal replace of the first "%s" instead.
+static void format_uri(char *dst, size_t dst_size, const char *tmpl, const char *address)
+{
+    const char *p = strstr(tmpl, "%s");
+    if (p == NULL) {
+        snprintf(dst, dst_size, "%s", tmpl);        // no placeholder: copy verbatim
+        return;
+    }
+    snprintf(dst, dst_size, "%.*s%s%s", (int)(p - tmpl), tmpl, address, p + 2);
+}
+
 int media_get_service_capabilities()
 {
     long size = cat(NULL, "media_service_files/GetServiceCapabilities.xml", 0);
@@ -495,9 +514,7 @@ int media_get_snapshot_uri()
             return -2;
         }
 
