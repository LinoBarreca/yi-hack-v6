# The full www is served from the SD/CIFS payload (extra/www), not flash, so it
# has no real space constraint: everything ships PLAIN - no HTML compression, no
# CSS/JS minification, no gzip. Plain files are easier to inspect and iterate on
# the share, and busybox httpd's directory index needs a plain index.html anyway.
#
# Layout: index.html + ui/ (our code, unminified) + vendor/ (Bootstrap/Alpine,
# unmodified upstream artifacts - see htdocs/vendor/VENDOR.md and
# scripts/fetch_www_vendor.sh for versions/checksums).

set -e

SCRIPT_DIR=$(cd `dirname $0` && pwd)
cd $SCRIPT_DIR

# Vendored libraries (Bootstrap/Alpine) are NOT in git: like every other module
# source they are downloaded at build time, sha256-verified and cached in
# httpd/htdocs/vendor/ (see htdocs/vendor/VENDOR.md). Fetch only when missing
# or corrupted, so normal rebuilds stay offline.
echo "Checking the vendored web libraries..."
if ! ../../scripts/fetch_www_vendor.sh --verify-only > /dev/null 2>&1; then
    ../../scripts/fetch_www_vendor.sh
fi

rm -rf ./_install/www
mkdir -p ./_install/www/cgi-bin ./_install/www/images

echo "Copying the web UI (index.html, ui/, vendor/, images/)..."
cp ./httpd/htdocs/index.html ./_install/www/index.html
cp -R ./httpd/htdocs/ui ./_install/www/ui
cp -R ./httpd/htdocs/vendor ./_install/www/vendor
rm -f ./_install/www/vendor/VENDOR.md   # doc lives in the repo, not on the camera
cp -R ./httpd/htdocs/images/. ./_install/www/images/

echo "Copying the cgi-bin folder..."
cp ./httpd/cgi-bin/* ./_install/www/cgi-bin

# Cache-bust the app assets. busybox httpd sends NO cache headers, so browsers
# heuristically cache ui/app.js, ui/app.css, etc. After a new build with the same
# URLs the browser then serves STALE JS/CSS against fresh (cache:'no-store') page
# fragments -> broken UI (e.g. an old app.js that predates a page's new bindings).
# Stamp the local script/style URLs in index.html with a content hash so any
# change to them yields a new URL = guaranteed reload; unchanged builds keep the
# same hash (no needless re-download). Page fragments already use no-store; vendor
# libs are version-pinned and change rarely, so only our own assets are stamped.
V=$(cat ./_install/www/ui/app.js ./_install/www/ui/rules.js \
        ./_install/www/ui/tz-data.js ./_install/www/ui/app.css | md5sum | cut -c1-10)
sed -i \
    -e "s|\"ui/tz-data.js\"|\"ui/tz-data.js?v=$V\"|" \
    -e "s|\"ui/app.js\"|\"ui/app.js?v=$V\"|" \
    -e "s|\"ui/rules.js\"|\"ui/rules.js?v=$V\"|" \
    -e "s|\"ui/app.css\"|\"ui/app.css?v=$V\"|" \
    ./_install/www/index.html
echo "Cache-bust stamp: v=$V"

echo "Compilation succeeded."
