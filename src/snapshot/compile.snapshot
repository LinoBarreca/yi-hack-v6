#!/bin/bash

export CROSSPATH=/opt/arm-hisiv300-linux/bin
export PATH=${PATH}:${CROSSPATH}

export TARGET=arm-hisiv300-linux-uclibcgnueabi
export CROSS=arm-hisiv300-linux-uclibcgnueabi
export BUILD=x86_64-pc-linux-gnu

export CROSSPREFIX=${CROSS}-

export STRIP=${CROSSPREFIX}strip
export CXX=${CROSSPREFIX}g++
export CC=${CROSSPREFIX}gcc
export LD=${CROSSPREFIX}ld
export AS=${CROSSPREFIX}as
export AR=${CROSSPREFIX}ar

SCRIPT_DIR=$(cd `dirname $0` && pwd)
cd $SCRIPT_DIR

cd snapshot || exit 1

make clean
make || exit 1

mkdir -p ../_install/bin || exit 1

cp ./imggrabber ../_install/bin || exit 1
# Ship the full ffmpeg binary (rtsp -> segmented mp4 remux) for the native
# recorder. Built from the same ffmpeg-6.0 tree as imggrabber's static libs.
cp ./ffmpeg-6.0/ffmpeg ../_install/bin || exit 1
mkdir -p ../_install/resources/watermark/low/
cp ./watermark/low/* ../_install/resources/watermark/low/ || exit 1
mkdir -p ../_install/resources/watermark/high/
cp ./watermark/high/* ../_install/resources/watermark/high/ || exit 1

${STRIP} ../_install/bin/* || exit 1
