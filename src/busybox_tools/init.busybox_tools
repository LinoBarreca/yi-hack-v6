#!/bin/bash

SCRIPT_DIR=$(cd `dirname $0` && pwd)
cd $SCRIPT_DIR

source config.busybox_tools

rm -rf ./_install

if [ ! -f "${ARCHIVE}" ]; then
    wget "${MAIN_URL}"
fi

tar xvf "${ARCHIVE}"

cd "${BUILD_FOLDER}"

# httpd patches for the full web UI (this is the busybox that serves it):
#  - onvif.patch: treat the onvif/ URL prefix as a CGI dir (onvif_simple_server)
#  - auth.patch : allow disabling auth on a path via an htpasswd entry of ":"
patch -p1 < ../onvif.patch || exit 1
patch -p1 < ../auth.patch || exit 1

cp ../.config ./ || exit 1
