SCRIPT_DIR=$(cd `dirname $0` && pwd)
cd $SCRIPT_DIR

# Extended busybox (full applet set + patched httpd) for the SD/CIFS payload.
#
# Split, FAT-safe + no-flash-write design:
#  - The BINARY lives in the payload: build/extra/bin/busybox (a regular file; FAT has no
#    symlinks, so extra/ holds only real files).
#  - The 155 applet entries are SYMLINKS in flash: build/home/yi-hack/base/bin/<applet> ->
#    /home/yi-hack/extra/bin/busybox. They live in the home jffs2 (symlinks ok), are created
#    once here, and are NEVER rewritten at boot.
#  - env.sh/profile only reorder PATH: when extra is mounted (extra/bin/busybox executable)
#    base/bin goes first -> every applet resolves to the full busybox; otherwise the rootfs
#    mini busybox wins. No runtime flash writes, no build_view flip.
#  - The same base/bin also holds dropbear (real binaries); PATH order keeps them separate.

EXTRA_BIN=../../build/extra/bin
FARM=../../build/home/yi-hack/base/bin
mkdir -p "$EXTRA_BIN" "$FARM"

# The binary goes to the payload.
cp -f ./_install/bin/busybox "$EXTRA_BIN/busybox"

# Flash farm: one symlink per compiled applet -> the payload busybox. make install (SYMLINKS
# mode) laid the applet names out under _install/{bin,sbin,usr/bin,usr/sbin}; flatten the
# names into base/bin (the only payload-busybox dir we put on PATH). argv[0] selects the applet.
for applet in $(find ./_install \( -type l -o -type f \) ! -name busybox -printf '%f\n' | sort -u); do
    ln -sf /home/yi-hack/extra/bin/busybox "$FARM/$applet"
done
