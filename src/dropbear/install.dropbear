#!/bin/bash

SCRIPT_DIR=$(cd `dirname $0` && pwd)
cd $SCRIPT_DIR

mkdir -p ../../build/home/yi-hack/base/bin/

arm-hisiv300-linux-uclibcgnueabi-strip ./_install/dropbearmulti
cp -a ./_install/dropbearmulti ../../build/home/yi-hack/base/bin/

ln -sf dropbearmulti ../../build/home/yi-hack/base/bin/dbclient
ln -sf dropbearmulti ../../build/home/yi-hack/base/bin/dropbearconvert
ln -sf dropbearmulti ../../build/home/yi-hack/base/bin/dropbearkey
ln -sf dropbearmulti ../../build/home/yi-hack/base/bin/scp
ln -sf dropbearmulti ../../build/home/yi-hack/base/bin/dropbear
ln -sf dbclient ../../build/home/yi-hack/base/bin/ssh
