#!/bin/sh

# Boot log: capture the whole v6 boot chain to a RAM file. /dev is tmpfs (no flash), present
# from the very start, and fresh each boot. Always-on (free). DEBUG_LOG (system.conf) decides SD
# persistence: 'no' = RAM only; 'yes' = persisted in S20 (normal troubleshooting); 'early' =
# persisted from HERE in S01udev (deep debugging of the S01 phase). The touch-test avoids aborting
# boot if the redirect fails; console echo is given up (camera is headless without a UART clip).
touch /dev/yi-boot.log 2>/dev/null && exec >> /dev/yi-boot.log 2>&1
echo "===== $(date '+%F %T') S01udev - boot start ====="

mkdir /dev/pts
mount -t devpts devpts /dev/pts

# /var is small (~28K) and entirely volatile (run sockets/pidfiles/utmp, spool/cron) but
# lives on the NOR-flash rootfs (mtd4). Mount it tmpfs to keep these frequent runtime writes
# (wpa_supplicant socket, pidfiles, utmp, crontab) off the flash. See flash-wear analysis.
mount -t tmpfs tmpfs /var -o size=1m
mkdir -p /var/run/wpa_supplicant /var/lock /var/spool/cron/crontabs

mkdir -p /dev/.udev
udevd --daemon
udevadm trigger
mount -t jffs2 /dev/mtdblock5 /home

/home/yi-hack/base/script/system_init.sh
/home/base/init.sh

