#!/bin/sh

# yi-hack-v6 boot dispatch.
# By now S01udev has run system_init.sh and /home/base/init.sh (WiFi up, SD mounted at /tmp/sd).

# Boot log: keep appending to the RAM log S01udev started (separate script -> re-redirect).
touch /dev/yi-boot.log 2>/dev/null && exec >> /dev/yi-boot.log 2>&1
echo "===== $(date '+%F %T') S20yi-hack - dispatch start ====="

ulimit -s 1024
export LD_LIBRARY_PATH=/home/lib:$LD_LIBRARY_PATH
export LD_LIBRARY_PATH=/home/app/locallib:$LD_LIBRARY_PATH
export LD_LIBRARY_PATH=/home/hisiko/hisilib:$LD_LIBRARY_PATH
export PATH=/home/app/localbin:$PATH
export PATH=/home/base/tools:$PATH

# Boot log -> SD persistence, gated by DEBUG_LOG (troubleshooting only). /home is mounted now,
# so the config is readable. When on: remount the SD sync (every write hits the card, so a
# boot that hangs anywhere still leaves a complete log to pull out), copy the pre-S20 RAM
# buffer onto the SD, then redirect live to the SD file. When off: SD stays standard (async),
# no SD writes - only the free RAM log in /dev/yi-boot.log (readable via SSH).
. /home/yi-hack/base/script/get_config.sh
# Ensure the BASE config files (system, wifi, cifs, output) exist with defaults
# BEFORE anything reads them - DEBUG_LOG just below, then wifi_up / mount_cifs /
# build_view. Runs on every boot path (a deleted base file self-heals here).
/home/yi-hack/base/script/check_conf.sh base
BOOTLOG=
if [ "$(get_config system.DEBUG_LOG)" = "yes" ]; then
    BOOTLOG=1
    if mount | grep -q " /tmp/sd " && touch /tmp/sd/yi-boot.log 2>/dev/null; then
        mount -o remount,sync /tmp/sd 2>/dev/null && echo "[bootlog] /tmp/sd remounted sync"
        cat /dev/yi-boot.log > /tmp/sd/yi-boot.log 2>/dev/null
        exec >> /tmp/sd/yi-boot.log 2>&1
        echo "===== [bootlog] live on SD (sync) from here ====="
        # Debug crash capture: send cores to the SD (gigabytes of space, pullable with the boot
        # log, no pressure on the 16M /tmp tmpfs). Only enabled here, with the SD writable, so a
        # crash loop can't fill RAM. core_pattern is global; ulimit -c is inherited by every
        # daemon launched from here on - minimal-boot ones below AND system.sh + its services.
        # (Cores hit the sync-mounted FAT, so each write is slow but durable - debug only.)
        mkdir -p /tmp/sd/cores
        echo "/tmp/sd/cores/core.%e.%p" > /proc/sys/kernel/core_pattern 2>/dev/null
        ulimit -c unlimited
        echo "[bootlog] core dumps enabled -> /tmp/sd/cores/core.%e.%p"
    else
        echo "[bootlog] DEBUG_LOG=yes but no writable SD -> RAM only (/dev/yi-boot.log), cores disabled"
    fi
fi
# diag: dump key state at boot checkpoints (only when bootlog is on, to keep it quiet/fast otherwise).
diag() {
    [ -n "$BOOTLOG" ] || return 0
    echo "----- diag: $* @ $(date '+%T') -----"
    echo "-- ifconfig wlan0 --";   ifconfig wlan0 2>/dev/null
    echo "-- wpa_cli status --";   wpa_cli -i wlan0 status 2>/dev/null
    echo "-- mount --";            mount 2>/dev/null
    echo "-- dmesg tail --";       dmesg 2>/dev/null | tail -25
    echo "-----"
}
diag "S20 entry (pre apply_config)"

# Config + payload from SD/CIFS. The SD is already mounted (system_init);
# the CIFS is not yet. WiFi is NOT up yet either (stock 'dispatch', which associates it,
# is commented out of app/init.sh and only runs later). Order:
#   1. apply_config  - only the SD is mounted, so it bootstraps cifs.conf + wifi.conf into
#                      flash (letting wifi_up/mount_cifs use them). Version-gated: the SD
#                      must carry a <root>/version matching the flash base, else nothing applies.
#   2. wifi_up       - associate WiFi BEFORE mount_cifs (creds from mtdblock2, overridable
#                      by wifi.conf). Without this, mount_cifs has no network -> minimal boot.
#   3. mount_cifs    - reads the (now bootstrapped) cifs.conf; mounts the CIFS if it is
#                      configured + reachable.
#   4. apply_config  - the CIFS is now mounted and, having priority, overrides the
#                      managed config (version-gated).
#   5. build_view    - logical view: CIFS if mounted+compatible, else SD, else minimal.
/home/yi-hack/base/script/apply_config.sh
/home/yi-hack/base/script/wifi_up.sh
diag "after wifi_up (WiFi associated? has IP?)"
/home/yi-hack/base/script/mount_cifs.sh
/home/yi-hack/base/script/apply_config.sh
diag "after mount_cifs"
if /home/yi-hack/base/script/build_view.sh; then
    diag "build_view -> PAYLOAD (full dispatcher)"
    # Payload present -> full dispatcher (RTSP/ONVIF/MQTT/cloud/... per config)
    /home/yi-hack/base/script/system.sh
else
    diag "build_view -> MINIMAL boot"
    # Minimal boot: no payload. Rescue web UI (www -> base/www-min), telnet and SSH are
    # always up - they are the ONLY recovery channels here, so they must not depend on
    # config. The stock Xiaomi cloud app runs so the camera is still usable via the Yi app,
    # unless privacy is enabled.
    # TODO: privacy flag + build the rescue UI (base/www-min).
    httpd -h /home/yi-hack/www &
    telnetd &
    # SSH recovery: dropbear lives in flash base/bin (no payload needed). Absolute path -
    # S20's PATH does not include base/bin. -R generates host keys on demand at the paths
    # compiled into the binary (/home/yi-hack/config/dropbear/, which ships in the home image);
    # -B allows blank password so SSH is reachable exactly like telnet.
    /home/yi-hack/base/bin/dropbear -R -B &
    if [ "$(cat /home/yi-hack/config/privacy 2>/dev/null)" != "on" ]; then
        (
            cd /home/app
            ./log_server &
            ./dispatch &
            sleep 2
            ./rmm &
            sleep 4
            ./mp4record &
            ./cloud &
            ./p2p_tnp &
            if [[ $(cat /home/app/.camver) != "yi_dome" ]] ; then
                ./oss &
            fi
            ./watch_process &
        )
    fi
fi
