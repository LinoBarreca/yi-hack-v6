# /etc/profile: system-wide .profile file for the Bourne shells
#
#
ulimit -s 1024
set_path_before()
{
	[ -d $1 ] && PATH="$1:$PATH"
}

# yi-hack environment (farm-first busybox PATH flip, LD_LIBRARY_PATH, TZ): single
# source in env.sh, shared with the services (system.sh sources it too). /home is
# mounted by S01udev, so it is up before any login shell can exist. The fallback
# covers the catastrophic /home-mount-failure case only: recovery shells must still
# have a usable PATH (same as env.sh's pre-payload branch).
if [ -r /home/yi-hack/base/script/env.sh ]; then
	. /home/yi-hack/base/script/env.sh
else
	export PATH="/usr/bin:/usr/sbin:/bin:/sbin:/home/base/tools:/home/app/localbin:/home/base:/home/yi-hack/base/bin"
fi
set_path_before /usr/local/sbin
set_path_before /usr/local/bin
export PATH

alias ll="ls -al"

