# upgrade_firmware - the stock cloud app calls this when an OTA is pushed:
#   $1 = OTA download URL (base)   $2 = expected MD5
# Stock would auto-download and flash. yi-hack disables the auto-update and only RECORDS the
# offer. When the SD/CIFS payload (extra) is present we persist the record under extra/OTA
# (pullable off the card) and also fetch the model's home image there for manual inspection/
# flash; otherwise we keep the record in volatile /tmp.

EXTRA=/home/yi-hack/extra
MODEL=""; read MODEL < /home/app/.camver

# Full download URL = base + model home image name (home_<model>m, model dynamic via .camver).
DL_URL="${1}home_${MODEL}m"

# extra is a symlink build_view points at the payload; -d is true only when it resolves to a dir.
if [ -d "$EXTRA" ]; then
    OTA_DIR="$EXTRA/OTA"
else
    OTA_DIR=/tmp
fi
mkdir -p "$OTA_DIR"

echo "URL: $DL_URL" > "$OTA_DIR/upgrade_data.txt"
echo "MD5: $2" >> "$OTA_DIR/upgrade_data.txt"

# Payload present: pull the image next to the record, then verify it against the expected MD5
# and append the verdict ("<path> MD5: <hash> OK" / "... NOK!") to the record.
if [ -d "$EXTRA" ]; then
    OUT="$OTA_DIR/home_${MODEL}m"
    wget -O "$OUT" "$DL_URL"
    dl_md5=$(md5sum "$OUT" | awk '{print $1}')
    if [ -n "$dl_md5" ] && [ "$dl_md5" = "$2" ]; then
        echo "$OUT MD5: $dl_md5 OK" >> "$OTA_DIR/upgrade_data.txt"
    else
        echo "$OUT MD5: $dl_md5 NOK!" >> "$OTA_DIR/upgrade_data.txt"
    fi
fi
