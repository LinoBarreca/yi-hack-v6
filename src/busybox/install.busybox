SCRIPT_DIR=$(cd `dirname $0` && pwd)
cd $SCRIPT_DIR

cp -a ./_install/* ../../build/rootfs/

# Replace the lsusb applet symlink with our shim (./lsusb), which normalizes output to stock
# busybox 1.20.2 format so stock/OTA lsusb parsers keep working - see comments in ./lsusb.
# rm FIRST so we overwrite the symlink itself, not the busybox binary it points to.
rm -f ../../build/rootfs/usr/bin/lsusb
cp ./lsusb ../../build/rootfs/usr/bin/lsusb
chmod 0755 ../../build/rootfs/usr/bin/lsusb

# Shim /bin/cmp over the stock Yi cmp binary (broken: 2KB strcmp, ignores -s, clamps to 0 -
# see comments in ./cmp). The pack overlay (cp -a --remove-destination build/rootfs -> image)
# replaces the stock /bin/cmp ELF with this shim, so apply_config's `cmp -s` is correct
# regardless of PATH order at boot. busybox's own cmp applet also lands at /usr/bin/cmp.
mkdir -p ../../build/rootfs/bin
cp ./cmp ../../build/rootfs/bin/cmp
chmod 0755 ../../build/rootfs/bin/cmp
