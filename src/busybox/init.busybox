#!/bin/bash

SCRIPT_DIR=$(cd `dirname $0` && pwd)
cd $SCRIPT_DIR

source config.busybox

rm -rf ./_install

if [ ! -f "${ARCHIVE}" ]; then
    wget "${MAIN_URL}"
fi

tar xvf "${ARCHIVE}"

cd "${BUILD_FOLDER}"

# No patches here: this is the minimal rootfs busybox (boot + mount). The httpd
# patches that serve the full web UI live in src/busybox_tools (the extended busybox).

cp ../.config ./ || exit 1
