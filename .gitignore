**/__pycache__
/build/*
!/build/.gitkeep

/stock_firmware/*
!/stock_firmware/README.md
!/stock_firmware/common/README.md

/sysroot/*
!/sysroot/.gitkeep

/out
/bin

# The following files are ignored because they need some cleanup
REQUIRED_PACKAGES
INIT_SUBMODULES.md

*.DS_Store

# Submodule build-dirtiness is handled by `ignore = dirty` in .gitmodules.
# Per-module build artifacts are handled by each src/<mod>/.gitignore.
scripts/packfiles.sh
.file.swp
src/**/busybox-1.*
src/curl/sysroot/**
src/ipc_cmd/ipc_cmd/*.o
src/ipc_cmd/ipc_cmd/ipc_multiplexer
src/ipc_cmd/ipc_cmd/ipc_read
src/ipc_cmd/ipc_cmd/ipc2file

